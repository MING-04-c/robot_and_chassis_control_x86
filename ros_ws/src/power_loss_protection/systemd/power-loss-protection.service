[Unit]
Description=MIDUPS power loss protection
Wants=network-online.target
After=network-online.target
Before=robot-control.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/usr/bin/bash /opt/power-loss-protection/run_power_loss_protection.sh /etc/power-loss-protection/config.json
Restart=on-failure
RestartSec=1
RuntimeDirectory=power-loss-protection
StateDirectory=power-loss-protection
UMask=0022
TimeoutStopSec=2

[Install]
WantedBy=multi-user.target
