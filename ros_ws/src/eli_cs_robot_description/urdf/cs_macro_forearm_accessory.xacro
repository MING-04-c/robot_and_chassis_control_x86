<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- LS65 前臂侧装盒体：用STL内重复的肘部轴壳与forearm肘部轴壳配准。 -->
  <xacro:macro name="cs_forearm_accessory" params="tf_prefix mesh_file x y z roll pitch yaw">
    <link name="${tf_prefix}forearm_accessory_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_file}"/>
        </geometry>
        <material name="ForearmAccessoryBlack">
          <color rgba="0.08 0.08 0.08 1.0"/>
        </material>
      </visual>
      <!-- 低面数近似碰撞：盒体 + 横向安装轴，避免直接用近4万三角面的STL拖慢MoveIt。 -->
      <collision name="controller_box_collision">
        <origin xyz="0 -0.109 0.093" rpy="0 0 0"/>
        <geometry>
          <box size="0.082 0.100 0.186"/>
        </geometry>
      </collision>
      <collision name="mounting_axis_collision">
        <origin xyz="0 -0.007 0.142" rpy="1.5707963267948966 0 0"/>
        <geometry>
          <cylinder radius="0.061" length="0.106"/>
        </geometry>
      </collision>
    </link>

    <joint name="${tf_prefix}forearm_accessory_fixed_joint" type="fixed">
      <parent link="${tf_prefix}forearm_link"/>
      <child link="${tf_prefix}forearm_accessory_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>
  </xacro:macro>
</robot>
